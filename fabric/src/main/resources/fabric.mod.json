{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Neki_play",
    "smarrtie",
    "KreedMan"
  ],
  "contact": {
    "homepage": "https://github.com/Nekiplay/Neo-Scripts",
    "issues": "https://github.com/Nekiplay/Neo-Scripts/issues",
    "sources": "https://github.com/Nekiplay/Neo-Scripts"
  },
  "license": "${mod_license}",
  "icon": "assets/neoscripts/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "com.nekiplay.neoscripts.Main",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "mixins.neoscripts.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": ">=0.141.2+1.21.11",
    "fabric-language-kotlin": ">=1.13.8+kotlin.2.3.0",
    "java": ">=21",
    "minecraft": "1.21.11"
  },
  "accessWidener": "neoscripts.accesswidener"
}
